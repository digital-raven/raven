
/* Based on Deathemonic by Heus-Sueh.
 *
 * https://github.com/Heus-Sueh/rofi-themes.git
*/
@import "../config.rasi"

configuration{
    modi: "drun";
    icon-theme: "Oranchelo";
    font: "CaskaydiaCove Nerd Font Mono 11";
    show-icons: true;
    terminal: "Kitty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: " ✠  Programs";
}

window {
    height: 33%;
    width: 33%;
    weight: 30%;
    border: 2px;
    border-radius: 8px;
}

mainbox {
    background-color: #00000000;
    border:2px;
    border-radius: 8px;
}

inputbar {
    children: [prompt,entry];
    background-color: #00000000;
    border-radius: 8px;
    padding: 2px;
    margin: 2px;
}

prompt {
    padding: 6px;
    border-radius: 8px;
    margin: 2px;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    border-radius: 8px;
    border: 1px;
    padding: 6px;
    margin: 2px;
}

listview {
    border: 2px;
    border-radius: 8px;
    padding: 6px;
    margin: 0px;
    columns: 1;
    lines: 7;
    background-color: #00000000;
}

element {
    padding: 6px;
    background-color: #00000000;
}

element-icon {
    size: 25px;
}

