
/* Based on Deathemonic by Heus-Sueh.
 *
 * https://github.com/Heus-Sueh/rofi-themes.git
*/
@import "./colors.rasi"

configuration{
    modi: "drun";
    icon-theme: "Oranchelo";
    font: "CaskaydiaCove Nerd Font Mono 11";
    show-icons: true;
    terminal: "Kitty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: " ✠  Programs";
}


window {
    height: 33%;
    width: 33%;
    weight: 30%;
    border: 2px;
    border-radius: 8px;
    border-color: @background;
    background-color: @background;
}

mainbox {
    background-color: @glass;
    border:2px;
    border-radius: 8px;
}

inputbar {
    children: [prompt,entry];
    background-color: @glass;
    border-radius: 8px;
    padding: 2px;
    margin: 2px;
}

prompt {
    background-color: @polaris-woods;
    padding: 6px;
    text-color: @white;
    border-radius: 8px;
    margin: 2px;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    border-radius: 8px;
    border: 1px;
    border-color: @accent;
    padding: 6px;
    margin: 2px;
    text-color: @foreground;
    background-color: @polaris-night;
}

listview {
    border: 2px;
    border-radius: 8px;
    padding: 6px;
    margin: 0px;
    columns: 1;
    lines: 7;
    background-color: @glass;
}

element {
    padding: 6px;
    background-color: @glass;
    text-color: @foreground;
}

element-text, element-icon , mode-switcher {
    background-color: @glass;
    text-color:       inherit;
}

element-icon {
    size: 25px;
}

element selected {
    text-color: @foreground-selected;
    background-color: @background-selected;
}
