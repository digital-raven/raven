# Stylix for styling applications.
#
{
  inputs,
  pkgs,
  ...
}: {
  imports = [
    inputs.stylix.homeModules.stylix
  ];

  stylix.enable = true;

  # Stylix can generate a color scheme from a wallpaper, or load a pre-made scheme.
  #stylix.image = ./Wallpapers/castle.jpg;
  #stylix.base16Scheme = "${pkgs.base16-schemes}/share/themes/tokyo-night-storm.yaml";

  # These color codes were generated by running kitten theme, selecting gruvbox-dark-hard

  ## name: Gruvbox Dark Hard
  ## author: Pavel Pertsev
  ## license: MIT/X11
  ## upstream: https://raw.githubusercontent.com/gruvbox-community/gruvbox-contrib/master/kitty/gruvbox-dark-hard.conf
  stylix.base16Scheme = {
    base00 = "3c3836";
    base01 = "cc241d";
    base02 = "98971a";
    base03 = "fb4934";
    base04 = "458588";
    base05 = "a89984";
    base06 = "689d6a";
    base07 = "fb4934";
    base08 = "cc241d";
    base09 = "fb4934";
    base0A = "d79921";
    base0B = "98971a";
    base0C = "689d6a";
    base0D = "458588";
    base0E = "b16286";
    base0F = "fbf1c7";
  };

  #stylix.autoEnable = false;
  stylix.targets.firefox.enable = false; # Todo: firefox doesn't seem to apply
  #stylix.targets.firefox.profileNames = ["default"];
  stylix.targets.hyprland.enable = false;
  stylix.targets.hyprlock.enable = false;
  stylix.targets.kitty.enable = true;
  stylix.targets.rofi.enable = true;
  stylix.targets.waybar.enable = false; # Go read how to update waybar
}
